// Analytics
export interface AdminAnalytics {
  totalUsers: number;
  activeSubscriptions: number;
  totalRevenue: number;
  monthlyRevenue: number;
  totalMovies: number;
  totalSeries: number;
  totalStories: number;
  pendingPayments: number;
  blockedUsers: number;
}

export const getAnalytics = async (): Promise<AdminAnalytics> => {
  try {
    const now = new Date();
    const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

    // Get all collections data in parallel
    const [usersSnapshot, paymentsSnapshot, moviesSnapshot, seriesSnapshot, storiesSnapshot] = await Promise.all([
      getDocs(collection(db, 'users')),
      getDocs(collection(db, 'payments')),
      getDocs(collection(db, 'movies')),
      getDocs(collection(db, 'series')),
      getDocs(collection(db, 'stories'))
    ]);

    const users = usersSnapshot.docs.map(doc => doc.data() as User);
    const payments = paymentsSnapshot.docs.map(doc => ({
      ...doc.data(),
      createdAt: safeToDate(doc.data().createdAt),
      ...(doc.data().completedAt && { completedAt: safeToDate(doc.data().completedAt) })
    })) as PaymentRequest[];

    // Calculate analytics
    const totalUsers = users.length;
    const activeSubscriptions = users.filter(user =>
      user.subscription &&
      user.subscription.isActive &&
      new Date(user.subscription.endDate) > now
    ).length;
    const blockedUsers = users.filter(user => user.isBlocked).length;

    const completedPayments = payments.filter(p => p.status === 'completed');
    const totalRevenue = completedPayments.reduce((sum, p) => sum + p.amount, 0);
    const monthlyRevenue = completedPayments
      .filter(p => p.completedAt && p.completedAt >= startOfMonth)
      .reduce((sum, p) => sum + p.amount, 0);

    const pendingPayments = payments.filter(p => p.status === 'pending').length;

    return {
      totalUsers,
      activeSubscriptions,
      totalRevenue,
      monthlyRevenue,
      totalMovies: moviesSnapshot.size,
      totalSeries: seriesSnapshot.size,
      totalStories: storiesSnapshot.size,
      pendingPayments,
      blockedUsers
    };
  } catch (error) {
    console.error('Error fetching analytics:', error);
    return {
      totalUsers: 0,
      activeSubscriptions: 0,
      totalRevenue: 0,
      monthlyRevenue: 0,
      totalMovies: 0,
      totalSeries: 0,
      totalStories: 0,
      pendingPayments: 0,
      blockedUsers: 0
    };
  }
};

// Real-time subscriptions for admin
export const subscribeToUsers = (callback: (users: User[]) => void) => {
  const q = query(collection(db, 'users'), orderBy('createdAt', 'desc'));

  return onSnapshot(q, (querySnapshot) => {
    console.log(`🔄 Real-time update: ${querySnapshot.docs.length} users`);
    const users = querySnapshot.docs.map(doc => {
      const data = doc.data();
      try {
        return {
          ...data,
          uid: data.uid || doc.id,
          createdAt: safeToDate(data.createdAt),
          lastLoginAt: safeToDate(data.lastLoginAt),
          subscription: data.subscription ? {
            ...data.subscription,
            startDate: safeToDate(data.subscription.startDate),
            endDate: safeToDate(data.subscription.endDate),
            createdAt: safeToDate(data.subscription.createdAt),
          } : null,
        } as User;
      } catch (userError) {
        console.error('Error parsing user document in real-time:', doc.id, userError);
        return {
          uid: doc.id,
          phoneNumber: data.phoneNumber || 'unknown',
          displayName: data.displayName || 'Unknown User',
          username: data.username || 'unknown',
          createdAt: safeToDate(data.createdAt),
          lastLoginAt: safeToDate(data.lastLoginAt),
          subscription: null,
          isBlocked: data.isBlocked || false,
          isAdult: data.isAdult || false,
          profilePhotoURL: data.profilePhotoURL || null,
          subscriptionHistory: [],
          paymentHistory: []
        } as User;
      }
    });
    callback(users);
  });
};

export const subscribeToPayments = (callback: (payments: PaymentRequest[]) => void) => {
  const q = query(collection(db, 'payments'), orderBy('createdAt', 'desc'));

  return onSnapshot(q, (querySnapshot) => {
    console.log(`🔄 Real-time update: ${querySnapshot.docs.length} payments`);
    const payments = querySnapshot.docs.map(doc => {
      const data = doc.data();
      try {
        return {
          ...data,
          id: doc.id,
          createdAt: safeToDate(data.createdAt),
          ...(data.completedAt && { completedAt: safeToDate(data.completedAt) }),
          ...(data.failedAt && { failedAt: safeToDate(data.failedAt) }),
          ...(data.cancelledAt && { cancelledAt: safeToDate(data.cancelledAt) })
        } as PaymentRequest;
      } catch (paymentError) {
        console.error('Error parsing payment in real-time:', doc.id, paymentError);
        return {
          id: doc.id,
          userId: data.userId || 'unknown',
          packageType: data.packageType || 'FEDHA',
          amount: data.amount || 0,
          phoneNumber: data.phoneNumber || 'unknown',
          status: data.status || 'pending',
          createdAt: safeToDate(data.createdAt)
        } as PaymentRequest;
      }
    });
    callback(payments);
  });
};

export const subscribeToAnalytics = (callback: (analytics: AdminAnalytics) => void) => {
  // Subscribe to multiple collections for real-time analytics
  const unsubscribeUsers = onSnapshot(collection(db, 'users'), () => {
    getAnalytics().then(callback);
  });

  const unsubscribePayments = onSnapshot(collection(db, 'payments'), () => {
    getAnalytics().then(callback);
  });

  // Return combined unsubscribe function
  return () => {
    unsubscribeUsers();
    unsubscribePayments();
  };
};

// Detailed Analytics Interface
export interface DetailedAnalytics {
  // Basic metrics
  totalUsers: number;
  activeSubscriptions: number;
  totalRevenue: number;
  monthlyRevenue: number;
  weeklyRevenue: number;
  dailyRevenue: number;
  totalMovies: number;
  totalSeries: number;
  totalStories: number;
  pendingPayments: number;
  blockedUsers: number;

  // Revenue breakdown
  revenueByPackage: {
    FEDHA: number;
    CHUMA: number;
    DHAHABU: number;
    ALMASI: number;
    MALKIA: number;
  };

  // Subscription breakdown
  subscriptionsByPackage: {
    FEDHA: number;
    CHUMA: number;
    DHAHABU: number;
    ALMASI: number;
    MALKIA: number;
  };

  // Payment statistics
  totalPayments: number;
  completedPayments: number;
  failedPayments: number;
  cancelledPayments: number;
  successRate: number;

  // User statistics
  newUsersToday: number;
  newUsersThisWeek: number;
  newUsersThisMonth: number;
  usersWithSubscription: number;
  usersWithoutSubscription: number;

  // Revenue trends (last 7 days)
  dailyRevenueLast7Days: { date: string; revenue: number }[];

  // User growth (last 7 days)
  dailyUsersLast7Days: { date: string; users: number }[];

  // Payment trends (last 7 days)
  dailyPaymentsLast7Days: { date: string; completed: number; failed: number }[];
}

export const getDetailedAnalytics = async (): Promise<DetailedAnalytics> => {
  try {
    const now = new Date();
    const startOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const startOfWeek = new Date(now);
    startOfWeek.setDate(now.getDate() - now.getDay());
    startOfWeek.setHours(0, 0, 0, 0);
    const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);

    // Get all collections data in parallel
    const [usersSnapshot, paymentsSnapshot, moviesSnapshot, seriesSnapshot, storiesSnapshot] = await Promise.all([
      getDocs(collection(db, 'users')),
      getDocs(collection(db, 'payments')),
      getDocs(collection(db, 'movies')),
      getDocs(collection(db, 'series')),
      getDocs(collection(db, 'stories'))
    ]);

    const users = usersSnapshot.docs.map(doc => {
      const data = doc.data();
      return {
        ...data,
        uid: data.uid || doc.id,
        createdAt: data.createdAt?.toDate ? data.createdAt.toDate() : new Date(),
        lastLoginAt: data.lastLoginAt?.toDate ? data.lastLoginAt.toDate() : new Date(),
        subscription: data.subscription ? {
          ...data.subscription,
          startDate: data.subscription.startDate?.toDate ? data.subscription.startDate.toDate() : new Date(),
          endDate: data.subscription.endDate?.toDate ? data.subscription.endDate.toDate() : new Date(),
        } : null,
      } as User;
    });

    const payments = paymentsSnapshot.docs.map(doc => ({
      ...doc.data(),
      id: doc.id,
      createdAt: doc.data().createdAt?.toDate ? doc.data().createdAt.toDate() : new Date(),
      ...(doc.data().completedAt && { completedAt: doc.data().completedAt?.toDate ? doc.data().completedAt.toDate() : new Date() })
    })) as PaymentRequest[];

    // Basic metrics
    const totalUsers = users.length;
    const activeSubscriptions = users.filter(user =>
      user.subscription &&
      user.subscription.isActive &&
      new Date(user.subscription.endDate) > now
    ).length;
    const blockedUsers = users.filter(user => user.isBlocked).length;

    // Payment statistics
    const completedPayments = payments.filter(p => p.status === 'completed');
    const failedPayments = payments.filter(p => p.status === 'failed');
    const cancelledPayments = payments.filter(p => p.status === 'cancelled');
    const totalPayments = payments.length;
    const successRate = totalPayments > 0 ? (completedPayments.length / totalPayments) * 100 : 0;

    // Revenue calculations
    const totalRevenue = completedPayments.reduce((sum, p) => sum + p.amount, 0);
    const monthlyRevenue = completedPayments
      .filter(p => p.completedAt && p.completedAt >= startOfMonth)
      .reduce((sum, p) => sum + p.amount, 0);
    const weeklyRevenue = completedPayments
      .filter(p => p.completedAt && p.completedAt >= startOfWeek)
      .reduce((sum, p) => sum + p.amount, 0);
    const dailyRevenue = completedPayments
      .filter(p => p.completedAt && p.completedAt >= startOfDay)
      .reduce((sum, p) => sum + p.amount, 0);

    // Revenue by package
    const revenueByPackage = {
      FEDHA: 0,
      CHUMA: 0,
      DHAHABU: 0,
      ALMASI: 0,
      MALKIA: 0
    };

    completedPayments.forEach(payment => {
      if (payment.packageType && revenueByPackage.hasOwnProperty(payment.packageType)) {
        revenueByPackage[payment.packageType as keyof typeof revenueByPackage] += payment.amount;
      }
    });

    // Subscriptions by package
    const subscriptionsByPackage = {
      FEDHA: 0,
      CHUMA: 0,
      DHAHABU: 0,
      ALMASI: 0,
      MALKIA: 0
    };

    users.forEach(user => {
      if (user.subscription && user.subscription.isActive && new Date(user.subscription.endDate) > now) {
        const packageType = user.subscription.packageType;
        if (subscriptionsByPackage.hasOwnProperty(packageType)) {
          subscriptionsByPackage[packageType as keyof typeof subscriptionsByPackage]++;
        }
      }
    });

    // User statistics
    const newUsersToday = users.filter(u => new Date(u.createdAt) >= startOfDay).length;
    const newUsersThisWeek = users.filter(u => new Date(u.createdAt) >= startOfWeek).length;
    const newUsersThisMonth = users.filter(u => new Date(u.createdAt) >= startOfMonth).length;
    const usersWithSubscription = users.filter(u => u.subscription && u.subscription.isActive && new Date(u.subscription.endDate) > now).length;
    const usersWithoutSubscription = totalUsers - usersWithSubscription;

    // Last 7 days revenue
    const dailyRevenueLast7Days: { date: string; revenue: number }[] = [];
    for (let i = 6; i >= 0; i--) {
      const date = new Date(now);
      date.setDate(now.getDate() - i);
      date.setHours(0, 0, 0, 0);
      const nextDate = new Date(date);
      nextDate.setDate(date.getDate() + 1);

      const revenue = completedPayments
        .filter(p => p.completedAt && p.completedAt >= date && p.completedAt < nextDate)
        .reduce((sum, p) => sum + p.amount, 0);

      dailyRevenueLast7Days.push({
        date: date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
        revenue
      });
    }

    // Last 7 days users
    const dailyUsersLast7Days: { date: string; users: number }[] = [];
    for (let i = 6; i >= 0; i--) {
      const date = new Date(now);
      date.setDate(now.getDate() - i);
      date.setHours(0, 0, 0, 0);
      const nextDate = new Date(date);
      nextDate.setDate(date.getDate() + 1);

      const usersCount = users.filter(u => {
        const userDate = new Date(u.createdAt);
        return userDate >= date && userDate < nextDate;
      }).length;

      dailyUsersLast7Days.push({
        date: date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
        users: usersCount
      });
    }

    // Last 7 days payments
    const dailyPaymentsLast7Days: { date: string; completed: number; failed: number }[] = [];
    for (let i = 6; i >= 0; i--) {
      const date = new Date(now);
      date.setDate(now.getDate() - i);
      date.setHours(0, 0, 0, 0);
      const nextDate = new Date(date);
      nextDate.setDate(date.getDate() + 1);

      const completed = completedPayments.filter(p => {
        const paymentDate = p.completedAt || p.createdAt;
        return paymentDate >= date && paymentDate < nextDate;
      }).length;

      const failed = failedPayments.filter(p => {
        const paymentDate = p.createdAt;
        return paymentDate >= date && paymentDate < nextDate;
      }).length;

      dailyPaymentsLast7Days.push({
        date: date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
        completed,
        failed
      });
    }

    return {
      totalUsers,
      activeSubscriptions,
      totalRevenue,
      monthlyRevenue,
      weeklyRevenue,
      dailyRevenue,
      totalMovies: moviesSnapshot.size,
      totalSeries: seriesSnapshot.size,
      totalStories: storiesSnapshot.size,
      pendingPayments: payments.filter(p => p.status === 'pending').length,
      blockedUsers,
      revenueByPackage,
      subscriptionsByPackage,
      totalPayments,
      completedPayments: completedPayments.length,
      failedPayments: failedPayments.length,
      cancelledPayments: cancelledPayments.length,
      successRate,
      newUsersToday,
      newUsersThisWeek,
      newUsersThisMonth,
      usersWithSubscription,
      usersWithoutSubscription,
      dailyRevenueLast7Days,
      dailyUsersLast7Days,
      dailyPaymentsLast7Days
    };
  } catch (error) {
    console.error('Error fetching detailed analytics:', error);
    return {
      totalUsers: 0,
      activeSubscriptions: 0,
      totalRevenue: 0,
      monthlyRevenue: 0,
      weeklyRevenue: 0,
      dailyRevenue: 0,
      totalMovies: 0,
      totalSeries: 0,
      totalStories: 0,
      pendingPayments: 0,
      blockedUsers: 0,
      revenueByPackage: { FEDHA: 0, CHUMA: 0, DHAHABU: 0, ALMASI: 0, MALKIA: 0 },
      subscriptionsByPackage: { FEDHA: 0, CHUMA: 0, DHAHABU: 0, ALMASI: 0, MALKIA: 0 },
      totalPayments: 0,
      completedPayments: 0,
      failedPayments: 0,
      cancelledPayments: 0,
      successRate: 0,
      newUsersToday: 0,
      newUsersThisWeek: 0,
      newUsersThisMonth: 0,
      usersWithSubscription: 0,
      usersWithoutSubscription: 0,
      dailyRevenueLast7Days: [],
      dailyUsersLast7Days: [],
      dailyPaymentsLast7Days: []
    };
  }
};

export const subscribeToDetailedAnalytics = (callback: (analytics: DetailedAnalytics) => void) => {
  // Subscribe to multiple collections for real-time analytics
  const unsubscribeUsers = onSnapshot(collection(db, 'users'), () => {
    getDetailedAnalytics().then(callback);
  });

  const unsubscribePayments = onSnapshot(collection(db, 'payments'), () => {
    getDetailedAnalytics().then(callback);
  });

  const unsubscribeMovies = onSnapshot(collection(db, 'movies'), () => {
    getDetailedAnalytics().then(callback);
  });

  const unsubscribeSeries = onSnapshot(collection(db, 'series'), () => {
    getDetailedAnalytics().then(callback);
  });

  const unsubscribeStories = onSnapshot(collection(db, 'stories'), () => {
    getDetailedAnalytics().then(callback);
  });

  // Return combined unsubscribe function
  return () => {
    unsubscribeUsers();
    unsubscribePayments();
    unsubscribeMovies();
    unsubscribeSeries();
    unsubscribeStories();
  };
};