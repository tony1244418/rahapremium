export const deleteSeries = async (seriesId: string): Promise<void> => {
  try {
    const batch = writeBatch(db);

    // Delete series document
    const seriesRef = doc(db, 'series', seriesId);
    batch.delete(seriesRef);

    // Delete all seasons
    const seasonsQuery = query(collection(db, 'seasons'), where('seriesId', '==', seriesId));
    const seasonsSnapshot = await getDocs(seasonsQuery);
    seasonsSnapshot.docs.forEach(seasonDoc => {
      batch.delete(seasonDoc.ref);
    });

    // Delete all episodes
    const episodesQuery = query(collection(db, 'episodes'), where('seriesId', '==', seriesId));
    const episodesSnapshot = await getDocs(episodesQuery);
    episodesSnapshot.docs.forEach(episodeDoc => {
      batch.delete(episodeDoc.ref);
    });

    await batch.commit();
  } catch (error) {
    console.error('Error deleting series:', error);
    throw error;
  }
};

