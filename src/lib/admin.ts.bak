// Payment Management
export const getAllPayments = async (): Promise<PaymentRequest[]> => {
  try {
    const q = query(collection(db, 'payments'), orderBy('createdAt', 'desc'));
    const querySnapshot = await getDocs(q);

    console.log(`💳 Fetched ${querySnapshot.docs.length} payments from Firestore`);

    return querySnapshot.docs.map(doc => {
      const data = doc.data();
      try {
        return {
          ...data,
          id: doc.id,
          createdAt: safeToDate(data.createdAt),
          ...(data.completedAt && { completedAt: safeToDate(data.completedAt) }),
          ...(data.failedAt && { failedAt: safeToDate(data.failedAt) }),
          ...(data.cancelledAt && { cancelledAt: safeToDate(data.cancelledAt) })
        } as PaymentRequest;
      } catch (paymentError) {
        console.error('Error parsing payment document:', doc.id, paymentError);
        // Return minimal valid payment object
        return {
          id: doc.id,
          userId: data.userId || 'unknown',
          packageType: data.packageType || 'FEDHA',
          amount: data.amount || 0,
          phoneNumber: data.phoneNumber || 'unknown',
          status: data.status || 'pending',
          createdAt: safeToDate(data.createdAt)
        } as PaymentRequest;
      }
    });
  } catch (error) {
    console.error('Error fetching payments:', error);
    return [];
  }
};

export const getPaymentById = async (paymentId: string): Promise<PaymentRequest | null> => {
  try {
    const docRef = doc(db, 'payments', paymentId);
    const docSnap = await getDoc(docRef);

    if (docSnap.exists()) {
      const data = docSnap.data();
      return {
        ...data,
        id: docSnap.id,
        createdAt: safeToDate(data.createdAt),
        ...(data.completedAt && { completedAt: safeToDate(data.completedAt) }),
        ...(data.failedAt && { failedAt: safeToDate(data.failedAt) }),
        ...(data.cancelledAt && { cancelledAt: safeToDate(data.cancelledAt) })
      } as PaymentRequest;
    }
    return null;
  } catch (error) {
    console.error('Error fetching payment:', error);
    return null;
  }
};

