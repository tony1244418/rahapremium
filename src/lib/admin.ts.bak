import {
  collection,
  doc,
  getDocs,
  getDoc,
  addDoc,
  updateDoc,
  deleteDoc,
  query,
  where,
  orderBy,
  limit,
  onSnapshot,
  Timestamp,
  writeBatch
} from 'firebase/firestore';
import { db } from './firebase';
import {
  User,
  Movie,
  Series,
  Story,
  PaymentRequest,
  AdminUser,
  UserSubscription,
  SubscriptionPackage
} from '@/types';
import { processSubscription, completePayment, failPayment } from './subscriptions';

// Phone number normalization utility
export const normalizePhoneNumber = (phoneNumber: string): string => {
  if (!phoneNumber) return phoneNumber;

  // Remove all non-digit characters
  let cleaned = phoneNumber.replace(/\D/g, '');

  // If it starts with 255, convert to +255 format
  if (cleaned.startsWith('255')) {
    return `+${cleaned}`;
  }

  // If it starts with 0, convert to +255 format
  if (cleaned.startsWith('0')) {
    return `+255${cleaned.substring(1)}`;
  }

  // If it doesn't start with +, add it
  if (!phoneNumber.startsWith('+')) {
    return `+${cleaned}`;
  }

  return phoneNumber;
};

// Helper function to safely convert various date formats to Date object
const safeToDate = (value: any): Date => {
  if (!value) return new Date();
  if (value.toDate && typeof value.toDate === 'function') return value.toDate();
  if (value instanceof Date) return value;
  if (typeof value === 'string' || typeof value === 'number') return new Date(value);
  return new Date();
};

// User Management
export const getAllUsers = async (): Promise<User[]> => {
  try {
    const q = query(collection(db, 'users'), orderBy('createdAt', 'desc'));
    const querySnapshot = await getDocs(q);

    console.log(`📊 Fetched ${querySnapshot.docs.length} users from Firestore`);

    return querySnapshot.docs.map(doc => {
      const data = doc.data();
      try {
        return {
          ...data,
          uid: data.uid || doc.id,
          createdAt: safeToDate(data.createdAt),
          lastLoginAt: safeToDate(data.lastLoginAt),
          subscription: data.subscription ? {
            ...data.subscription,
            startDate: safeToDate(data.subscription.startDate),
            endDate: safeToDate(data.subscription.endDate),
            createdAt: safeToDate(data.subscription.createdAt),
          } : null,
        } as User;
      } catch (userError) {
        console.error('Error parsing user document:', doc.id, userError);
        // Return a minimal valid user object to prevent total failure
        return {
          uid: doc.id,
          phoneNumber: data.phoneNumber || 'unknown',
          displayName: data.displayName || 'Unknown User',
          username: data.username || 'unknown',
          createdAt: safeToDate(data.createdAt),
          lastLoginAt: safeToDate(data.lastLoginAt),
          subscription: null,
          isBlocked: data.isBlocked || false,
          isAdult: data.isAdult || false,
          profilePhotoURL: data.profilePhotoURL || null,
          subscriptionHistory: [],
          paymentHistory: []
        } as User;
      }
    });
  } catch (error) {
    console.error('Error fetching users:', error);
    return [];
  }
};

export const getUserById = async (userId: string): Promise<User | null> => {
  try {
    const docRef = doc(db, 'users', userId);
    const docSnap = await getDoc(docRef);

    if (docSnap.exists()) {
      const data = docSnap.data();
      return {
        ...data,
        uid: data.uid || docSnap.id,
        createdAt: safeToDate(data.createdAt),
        lastLoginAt: safeToDate(data.lastLoginAt),
        subscription: data.subscription ? {
          ...data.subscription,
          startDate: safeToDate(data.subscription.startDate),
          endDate: safeToDate(data.subscription.endDate),
          createdAt: safeToDate(data.subscription.createdAt),
        } : null,
      } as User;
    }
    return null;
  } catch (error) {
    console.error('Error fetching user:', error);
    return null;
  }
};

export const getUserByPhoneNumber = async (phoneNumber: string): Promise<User | null> => {
  try {
    // Normalize phone number to +255 format (standard format in database)
    const normalizedPhone = normalizePhoneNumber(phoneNumber);

    // Try with normalized phone number first
    let q = query(collection(db, 'users'), where('phoneNumber', '==', normalizedPhone));
    let querySnapshot = await getDocs(q);

    if (!querySnapshot.empty) {
      const doc = querySnapshot.docs[0];
      const data = doc.data();
      return {
        ...data,
        uid: data.uid || doc.id,
        createdAt: safeToDate(data.createdAt),
        lastLoginAt: safeToDate(data.lastLoginAt),
        subscription: data.subscription ? {
          ...data.subscription,
          startDate: safeToDate(data.subscription.startDate),
          endDate: safeToDate(data.subscription.endDate),
          createdAt: safeToDate(data.subscription.createdAt),
        } : null,
      } as User;
    }

    // If not found, try with original phone number (in case it's already in correct format)
    if (phoneNumber !== normalizedPhone) {
      q = query(collection(db, 'users'), where('phoneNumber', '==', phoneNumber));
      querySnapshot = await getDocs(q);

      if (!querySnapshot.empty) {
        const doc = querySnapshot.docs[0];
        const data = doc.data();
        return {
          ...data,
          uid: data.uid || doc.id,
          createdAt: safeToDate(data.createdAt),
          lastLoginAt: safeToDate(data.lastLoginAt),
          subscription: data.subscription ? {
            ...data.subscription,
            startDate: safeToDate(data.subscription.startDate),
            endDate: safeToDate(data.subscription.endDate),
            createdAt: safeToDate(data.subscription.createdAt),
          } : null,
        } as User;
      }
    }

    return null;
  } catch (error) {
    console.error('Error fetching user by phone number:', error);
    return null;
  }
};

/**
 * Finds the user account (by phone number) that has an active subscription.
 * Handles duplicate-account cases by iterating ALL matching users and returning
 * the one whose subscription.isActive === true.
 */
export const getActiveSubUserByPhone = async (phoneNumber: string): Promise<User | null> => {
  try {
    const normalizedPhone = normalizePhoneNumber(phoneNumber);
    const formats = [normalizedPhone];
    if (phoneNumber !== normalizedPhone) formats.push(phoneNumber);

    for (const phone of formats) {
      const q = query(collection(db, 'users'), where('phoneNumber', '==', phone));
      const snap = await getDocs(q);
      for (const docSnap of snap.docs) {
        const data = docSnap.data();
        if (data.subscription?.isActive) {
          return {
            ...data,
            uid: data.uid || docSnap.id,
            createdAt: safeToDate(data.createdAt),
            lastLoginAt: safeToDate(data.lastLoginAt),
            subscription: {
              ...data.subscription,
              startDate: safeToDate(data.subscription.startDate),
              endDate: safeToDate(data.subscription.endDate),
              createdAt: safeToDate(data.subscription.createdAt),
            },
          } as User;
        }
      }
    }
    return null;
  } catch (error) {
    console.error('Error in getActiveSubUserByPhone:', error);
    return null;
  }
};

export const blockUser = async (userId: string): Promise<void> => {
  try {
    const userRef = doc(db, 'users', userId);
    await updateDoc(userRef, {
      isBlocked: true,
      blockedAt: Timestamp.now()
    });
  } catch (error) {
    console.error('Error blocking user:', error);
    throw error;
  }
};

export const unblockUser = async (userId: string): Promise<void> => {
  try {
    const userRef = doc(db, 'users', userId);
    await updateDoc(userRef, {
      isBlocked: false,
      unblockedAt: Timestamp.now()
    });
  } catch (error) {
    console.error('Error unblocking user:', error);
    throw error;
  }
};

export const deleteUser = async (userId: string): Promise<void> => {
  try {
    const batch = writeBatch(db);

    // Delete user document
    const userRef = doc(db, 'users', userId);
    batch.delete(userRef);

    // Delete user's payment history
    const paymentsQuery = query(collection(db, 'payments'), where('userId', '==', userId));
    const paymentsSnapshot = await getDocs(paymentsQuery);
    paymentsSnapshot.docs.forEach(paymentDoc => {
      batch.delete(paymentDoc.ref);
    });

    await batch.commit();
  } catch (error) {
    console.error('Error deleting user:', error);
    throw error;
  }
};

export const addManualSubscription = async (
  userId: string,
  packageType: SubscriptionPackage,
  adminId: string
): Promise<void> => {
  try {
    console.log('💰 MANUAL PAYMENT: Starting addManualSubscription for user:', userId, 'package:', packageType);
    const user = await getUserById(userId);
    if (!user) throw new Error('User not found');

    // Create a manual payment record for tracking
    const paymentData = {
      userId,
      packageType,
      amount: 0, // Manual subscription
      phoneNumber: user.phoneNumber,
      status: 'completed' as const,
      isManuallyCompleted: true,
      completedBy: adminId,
      createdAt: Timestamp.now(),
      completedAt: Timestamp.now()
    };

    const paymentRef = await addDoc(collection(db, 'payments'), paymentData);

    // Process the subscription
    await processSubscription(user, packageType, paymentRef.id, true, adminId);
  } catch (error) {
    console.error('Error adding manual subscription:', error);
    throw error;
  }
};

export const addDirectSubscription = async (
  userId: string,
  packageType: SubscriptionPackage,
  adminId: string
): Promise<void> => {
  try {
    console.log('🚀 DIRECT SUBSCRIPTION: Starting addDirectSubscription for user:', userId, 'package:', packageType);
    const user = await getUserById(userId);
    if (!user) throw new Error('User not found');

    // Import subscription functions
    const { SUBSCRIPTION_PACKAGES, calculateSubscriptionEndDate, isUpgrade, calculateDoubledDuration } = await import('./subscriptions');

    const packageConfig = SUBSCRIPTION_PACKAGES[packageType];
    const now = new Date();

    // Determine subscription type and calculate end date
    const isRenewal = user.subscription &&
      user.subscription.packageType === packageType &&
      user.subscription.isActive;

    const isUpgradeTransaction = user.subscription &&
      user.subscription.isActive &&
      isUpgrade(user.subscription.packageType, packageType);

    let endDate: Date;
    let isRenewalFlag = false;
    let isUpgradeFlag = false;

    if (isRenewal && user.subscription && user.subscription.isActive) {
      // Same package renewal - add standard duration to current end date
      const currentEndDate = new Date(user.subscription.endDate);
      endDate = new Date(currentEndDate.getTime() + (packageConfig.days * 24 * 60 * 60 * 1000));
      isRenewalFlag = true;
    } else if (isUpgradeTransaction && user.subscription) {
      // Upgrade - add standard duration to current end date (not doubled)
      const currentEndDate = new Date(user.subscription.endDate);
      endDate = new Date(currentEndDate.getTime() + (packageConfig.days * 24 * 60 * 60 * 1000));
      isUpgradeFlag = true;
    } else if (user.subscription && user.subscription.isActive) {
      // Stacking: Add new package time to existing subscription
      const remainingTime = user.subscription.endDate.getTime() - now.getTime();
      const newPackageTime = packageConfig.days * 24 * 60 * 60 * 1000;
      endDate = new Date(now.getTime() + remainingTime + newPackageTime);
    } else {
      // New subscription
      endDate = calculateSubscriptionEndDate(user, packageType);
    }

    // Create new subscription directly
    const newSubscription = {
      id: `sub_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
      packageType,
      startDate: Timestamp.fromDate(now),
      endDate: Timestamp.fromDate(endDate),
      isActive: true,
      transactionId: `direct_${Date.now()}`,
      amount: packageConfig.price, // Use actual package price
      isRenewal: isRenewalFlag,
      isUpgrade: isUpgradeFlag,
      previousPackage: user.subscription?.packageType || null,
      createdAt: Timestamp.fromDate(now),
      addedBy: adminId
    };

    // Update user document directly
    const userRef = doc(db, 'users', userId);
    const updatedSubscriptionHistory = [...(user.subscriptionHistory || []), newSubscription];

    // Deactivate previous subscription if exists
    if (user.subscription) {
      const updatedHistory = updatedSubscriptionHistory.map(sub =>
        sub.id === user.subscription?.id ? { ...sub, isActive: false } : sub
      );
      updatedSubscriptionHistory.splice(0, updatedSubscriptionHistory.length, ...updatedHistory);
    }

    await updateDoc(userRef, {
      subscription: newSubscription,
      subscriptionHistory: updatedSubscriptionHistory.map(sub => ({
        ...sub,
        startDate: sub.startDate instanceof Date ? Timestamp.fromDate(sub.startDate) : sub.startDate,
        endDate: sub.endDate instanceof Date ? Timestamp.fromDate(sub.endDate) : sub.endDate,
        createdAt: sub.createdAt instanceof Date ? Timestamp.fromDate(sub.createdAt) : sub.createdAt
      }))
    });

    console.log('✅ DIRECT SUBSCRIPTION: Successfully added for user', userId, 'by admin', adminId, 'Package:', packageType, 'Amount:', packageConfig.price);

    // Force refresh user data in real-time
    try {
      const userRef = doc(db, 'users', userId);
      await updateDoc(userRef, {
        lastUpdated: Timestamp.now()
      });
      console.log('🔄 User data refresh triggered for real-time update');
    } catch (refreshError) {
      console.warn('Could not trigger user data refresh:', refreshError);
    }
  } catch (error) {
    console.error('Error adding direct subscription:', error);
    throw error;
  }
};

export const removeUserSubscription = async (
  userId: string,
  adminId: string
): Promise<void> => {
  try {
    const user = await getUserById(userId);
    if (!user) throw new Error('User not found');

    const userRef = doc(db, 'users', userId);

    // Remove the active subscription
    await updateDoc(userRef, {
      subscription: null
    });

    console.log(`Subscription removed for user ${userId} by admin ${adminId}`);

    // Force refresh user data in real-time
    try {
      const userRef = doc(db, 'users', userId);
      await updateDoc(userRef, {
        lastUpdated: Timestamp.now()
      });
      console.log('User data refresh triggered for real-time update');
    } catch (refreshError) {
      console.warn('Could not trigger user data refresh:', refreshError);
    }
  } catch (error) {
    console.error('Error removing user subscription:', error);
    throw error;
  }
};

