# Firebase Configuration Example
# Copy this file to .env.local and fill in your actual Firebase credentials
# Get these values from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Live TV / CDN Token Service ───────────────────────────────────────────
# Server-side ONLY. These mint fresh CDN tokens for the Live TV / IPTV feature.
# The API key is a SECRET — it must NEVER be exposed to the browser, shipped in
# mobile/client code, or committed to a public repo. Note there is no
# NEXT_PUBLIC_ prefix, which keeps it server-side in Next.js.
TOKEN_SERVICE_URL=https://aztv-token-service.onrender.com
TOKEN_SERVICE_API_KEY=your_token_service_api_key_here
# Optional — CDN host used as a fallback if the service response omits cdnHost.
CDN_HOST=https://cdnedgch2.azamtvltd.co.tz

# ─── DASH → HLS Transcoder (iPhone Live TV support) ─────────────────────────
# Public URL of your DASH-to-HLS transcoder server (see /transcoder-server).
# iPhone/Safari can't play DASH, so iOS users are routed through this server
# which converts the stream to HLS on-the-fly. Leave blank to disable.
# Example (Cloudflare Tunnel): https://random-name.trycloudflare.com
NEXT_PUBLIC_TRANSCODER_URL=

# ─── Payment Gateway Webhooks ──────────────────────────────────────────────
# These are the callback URLs that payment providers will call after payment completion
# Replace 'your-production-domain.com' with your actual Vercel domain or custom domain
CLICKPESA_CALLBACK_URL=https://your-production-domain.com/api/payments/clickpesa/callback
HARAKAPAY_WEBHOOK_URL=https://your-production-domain.com/api/payments/harakapay/webhook
