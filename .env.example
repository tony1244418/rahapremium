

# ─── Supabase ──────────────────────────────────────────────────────────────
# Public client credentials — safe to expose to the browser (the anon key is
# protected by Row Level Security). Both use the NEXT_PUBLIC_ prefix so they
# are available client-side in Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side ONLY. Bypasses Row Level Security — NEVER expose this to the
# browser or commit the real value. No NEXT_PUBLIC_ prefix keeps it server-side.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Site / Domain ─────────────────────────────────────────────────────────
# The canonical www host and the bare apex host used for redirects in middleware.
NEXT_PUBLIC_SITE_URL=https://www.rahapremium.com
NEXT_PUBLIC_CANONICAL_HOST=www.rahapremium.com
NEXT_PUBLIC_APEX_HOST=rahapremium.com

# ─── Adult Site Domain ─────────────────────────────────────────────────────
# Domain that serves the +18 adult-only experience (same DB/auth/payments).
NEXT_PUBLIC_ADULT_DOMAIN=adult.rahapremium.site

# ─── Support Contact Defaults ──────────────────────────────────────────────
# Used as the initial default values for support email/WhatsApp before the
# admin saves them via the Control Center settings panel.
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=+255700000000

# ─── ClickPesa (fallback payment gateway) ──────────────────────────────────
# Server-side ONLY. All four values are required for ClickPesa to work.
# CLICKPESA_API_BASE — the ClickPesa API base URL.
# CLICKPESA_ORIGIN   — the registered origin/domain for your ClickPesa app.
# CLICKPESA_CALLBACK_URL — where ClickPesa posts payment status updates.
#   If omitted, falls back to: NEXT_PUBLIC_SITE_URL/api/webhook/clickpesa
CLICKPESA_API_BASE=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=your_clickpesa_client_id_here
CLICKPESA_API_KEY=your_clickpesa_api_key_here
CLICKPESA_ORIGIN=https://yourdomain.com
CLICKPESA_CALLBACK_URL=https://www.yourdomain.com/api/webhook/clickpesa

# ─── Pressso Pay (primary payment gateway) ─────────────────────────────────
# Server-side ONLY. Create the key/secret on the Pressso API credentials page.
# The SECRET is shown once at creation — store it here / in the hosting env and
# NEVER commit the real value or expose it to the browser.
PRESSSO_BASE_URL=https://pressopay.com
PRESSSO_API_KEY=pk_your_pressso_key_here
PRESSSO_API_SECRET=sk_your_pressso_secret_here

# ─── Live TV / CDN Token Service ───────────────────────────────────────────
# Server-side ONLY. These mint fresh CDN tokens for the Live TV / IPTV feature.
# The API key is a SECRET — it must NEVER be exposed to the browser, shipped in
# mobile/client code, or committed to a public repo. Note there is no
# NEXT_PUBLIC_ prefix, which keeps it server-side in Next.js.
TOKEN_SERVICE_URL=https://your-token-service.example.com
TOKEN_SERVICE_API_KEY=your_token_service_api_key_here
# Optional — CDN host used as a fallback if the service response omits cdnHost.
CDN_HOST=https://your-cdn-host.example.com

# ─── Cron: Token Refresh ───────────────────────────────────────────────────
# The URL the cron refresh route fetches a new token from.
TOKEN_SOURCE_URL=https://your-token-source.example.com/api/token
# Optional — protect the /api/cron/refresh-token route with a Bearer secret.
CRON_SECRET=your_cron_secret_here

# ─── DASH → HLS Transcoder (for iPhone/iPad) ───────────────────────────────
# iPhone/iPad Safari cannot play DASH (.mpd) streams. This is the public URL
# of the local transcoder server (Cloudflare Tunnel) that converts DASH to HLS
# on the fly. When set, the Live TV page routes Apple mobile users through it.
# NOTE: with the free trycloudflare tunnel this URL changes on every restart —
# update it here (and on Vercel) whenever the tunnel restarts.
NEXT_PUBLIC_TRANSCODER_URL=https://your-tunnel-name.trycloudflare.com
